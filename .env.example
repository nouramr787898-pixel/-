OPENAI_API_KEY=your_openai_api_key
SUMMARY_MODEL=gpt-4.1-mini

# Optional but strongly recommended for reliable calls across different mobile/Wi-Fi networks.
# Create your own TURN credential and put the values in Railway Variables.
TURN_URLS=turn:your-turn-server:80,turn:your-turn-server:443,turns:your-turn-server:443?transport=tcp
TURN_USERNAME=your_turn_username
TURN_CREDENTIAL=your_turn_password
